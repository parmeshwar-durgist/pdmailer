# Server Port & Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hr_mailer_db
# Set DB_SSL=true when using cloud MySQL (e.g. Aiven, TiDB Cloud)
DB_SSL=false

# Security & Authentication
JWT_SECRET=hr_mailer_bulk_secret_change_in_production_jwt_2026_secure
JWT_EXPIRES_IN=7d

# Gmail SMTP Configuration
# Use your Google Account and generate an App Password (16 characters)
# under Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=parmeshwardurgist@gmail.com
GMAIL_APP_PASSWORD=

# Email Sender Profile
SENDER_NAME=Parmeshwar Durgist
SENDER_EMAIL=parmeshwardurgist@gmail.com

# Throttle & Queue Settings
EMAIL_DELAY_MS=2000
EMAIL_MAX_RETRIES=2

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

